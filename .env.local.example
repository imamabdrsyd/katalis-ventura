# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Claude via Vertex AI. Wajib satu baris; karakter newline private_key tetap ditulis sebagai \n.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Google Sheets Integration (playground)
# OAuth client type "Web application" di GCP project axion-071195.
# Redirect URI yang WAJIB terdaftar di client tsb:
#   http://localhost:3000/api/integrations/google-sheets/callback
#   https://axionventura.com/api/integrations/google-sheets/callback
#
# PERINGATAN: GOOGLE_OAUTH_CLIENT_ID bersifat permanen. Merotasinya
# menghanguskan SEMUA grant drive.file — tiap spreadsheet_id tersimpan jadi 403
# dan semua user harus memilih ulang filenya lewat Picker.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Kunci HMAC untuk menandatangani parameter `state` OAuth (CSRF + anti account-linking).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_OAUTH_STATE_SECRET=your-64-hex-char-key-here
# Dipakai mulai M2 (Google Picker). API key di-restrict ke Picker API + HTTP referrer.
# APP_ID = project NUMBER (angka), bukan project id "axion-071195".
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-picker-api-key
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=your-gcp-project-number

# Whatsapp Business API
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WEBHOOK_INBOUND_SECRET=your-webhook-inbound-secret
